<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.sullis</groupId>
  <artifactId>redis-playground</artifactId>
  <packaging>jar</packaging>
  <name>redis-playground</name>
  <version>0.0.1-SNAPSHOT</version>
  <description>redis-playground</description>
  <licenses>
    <license>
      <name>Apache License 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <properties>
    <!-- Unset, maven falls back to the platform encoding for both resource filtering and
         compilation, and says so twice per build. -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- A property rather than the compiler plugin's own <release>, so that the enforcer rule
         below and any IDE reading the pom see the same number the compiler does. -->
    <maven.compiler.release>17</maven.compiler.release>
    <logback.version>1.6.3</logback.version>
    <slf4j.version>2.0.19</slf4j.version>
    <jacoco.version>0.8.15</jacoco.version>
    <!-- The bundle-wide instruction coverage the jacoco check execution enforces. The bundle is
         the fixtures under src/main/java and nothing else, so this is a floor on how much of them
         the suite exercises; the suite sits a little above it. What it does not reach is the
         fixtures' own failure handling: the port search giving up, and the catch blocks in
         start() and close() that log and carry on. Reaching those means making a container or a
         client fail on demand, which tests a mock rather than anything Redis does. So treat a
         drop below this as real, but do not read the remainder as work to be done. -->
    <jacoco.minimum.coverage>0.94</jacoco.minimum.coverage>
    <!-- An escape hatch for a partial run: fixture coverage is not a meaningful number when
         surefire was pointed at one class, so -Dtest=Foo wants this set too. -->
    <jacoco.check.skip>false</jacoco.check.skip>
  </properties>

    <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>2.0.5</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>6.1.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
    </dependency>
    <dependency>
      <!-- A transitive of testcontainers, declared here because RedisCluster imports ExposedPort
           and Ports directly to bind a container port to the same port on the host. Its version
           is not managed by testcontainers-bom, so it is pinned here and tracks whatever
           testcontainers resolves. -->
      <groupId>com.github.docker-java</groupId>
      <artifactId>docker-java-api</artifactId>
      <version>3.7.1</version>
    </dependency>
    <dependency>
      <groupId>redis.clients</groupId>
      <artifactId>jedis</artifactId>
      <version>8.0.1</version>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>4.0.0-M1</version>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <version>4.3.0</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter-engine</artifactId>
        <scope>test</scope>
    </dependency>
      <dependency>
          <groupId>org.junit.jupiter</groupId>
          <artifactId>junit-jupiter-params</artifactId>
          <scope>test</scope>
      </dependency>
    <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-core</artifactId>
        <version>${logback.version}</version>
        <scope>test</scope>
    </dependency>
    <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
        <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.6.3</version>
          <executions>
            <execution>
              <id>enforce</id>
              <goals>
                <goal>enforce</goal>
              </goals>
              <configuration>
                <rules>
                  <!-- The floor the README states. Stated in one place would be stated
                       nowhere: a contributor on an older maven finds out here rather than
                       through whichever plugin happens to break first. -->
                  <requireMavenVersion>
                    <version>[3.9,)</version>
                  </requireMavenVersion>
                  <!-- maven.compiler.release is 17, and CI builds on 17 and 21. -->
                  <requireJavaVersion>
                    <version>[17,)</version>
                  </requireJavaVersion>
                  <!-- Maven's nearest-wins resolution will quietly pick a version *below* what
                       some other dependency asked for, and the mismatch surfaces at runtime as a
                       NoSuchMethodError rather than at build time. This rule turns that into a
                       build failure naming both versions. It is the rule that earns its keep
                       here: docker-java-api is pinned by hand to whatever testcontainers
                       resolves, so a testcontainers bump is exactly the shape of change that
                       can leave the two disagreeing. -->
                  <requireUpperBoundDeps/>
                  <banDuplicatePomDependencyVersions/>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
      <!--
        The compiler's own lint, turned up and made fatal, in the same spirit as the javadoc
        pass below: this tree compiles clean today, so the gate holds for free and the first
        warning it reports is a new one rather than the head of a backlog.

        -classfile is the one category left out, and it is left out because it does not report
        on this tree at all. It fires on annotations in a dependency's class files whose own
        types are absent: @SuppressFBWarnings, which testcontainers, docker-java and byte-buddy
        all carry and none of them bring spotbugs-annotations along for. Nothing to do about any
        of them short of declaring a dependency this project does not otherwise use.

        -Xlint:all is whatever the JDK in hand knows about, so a JDK newer than CI's 17 and 21
        can introduce a category this tree has never been held to. That is the gate working,
        but it does mean a contributor can see a failure CI does not.
      -->
      <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:all,-classfile</arg>
            </compilerArgs>
            <!-- -Werror. -->
            <failOnWarning>true</failOnWarning>
          </configuration>
      </plugin>
      <!--
        A lint pass over the comments rather than a docs site: nothing here is published, so
        what this is for is catching a {@link} that no longer resolves: a method renamed with
        the javadoc left behind. The output under target/reports/apidocs is a by-product.

        Both trees, because both are full of {@link}s and the test tree is the one that names
        classes it does not otherwise touch: ClusterExtensionTest explains itself in terms of
        ClusterTest, FixtureContractTest in terms of RedisReplication#close(). Those are exactly
        the references a rename leaves behind. Both trees are clean today, so the gate holds
        for free.
      -->
      <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
          <configuration>
            <!-- The fixtures are package-private, and at the default public-only visibility
                 javadoc finds nothing to document and fails saying so. -->
            <show>package</show>
            <!-- The missing group is off on purpose. These fixtures explain themselves in
                 prose, and turning that into @param/@return boilerplate to satisfy a linter
                 would be a worse comment, not a better one. -->
            <doclint>all,-missing</doclint>
            <failOnWarnings>true</failOnWarnings>
          </configuration>
          <executions>
            <execution>
              <id>check-javadoc</id>
              <!-- Bound into the main lifecycle rather than to verify, so that the `mvn test`
                   the README gives runs it too, and so that it fails in about two seconds,
                   before surefire starts forking JVMs and pulling images. -->
              <phase>process-classes</phase>
              <goals>
                <goal>javadoc-no-fork</goal>
              </goals>
            </execution>
            <execution>
              <id>check-test-javadoc</id>
              <!-- process-test-classes for the same reason check-javadoc uses process-classes:
                   it is the last phase before surefire, so this still fails ahead of any
                   container. It cannot go earlier, because the test sources are not compiled
                   until test-compile. -->
              <phase>process-test-classes</phase>
              <goals>
                <goal>test-javadoc-no-fork</goal>
              </goals>
            </execution>
          </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <forkCount>8</forkCount>
          <reuseForks>true</reuseForks>
        </configuration>
      </plugin>

      <!--
        Declared after surefire on purpose: the merge and report executions below are bound to
        the test phase, and goals within one phase run in the order their plugins appear here,
        so moving this above surefire would report on an execution file that does not exist yet.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <!-- One execution file per fork. surefire runs up to forkCount JVMs at once and
                   expands ${surefire.forkNumber} per fork in the argLine this goal sets; a
                   single shared destFile would have eight JVMs appending to it concurrently. -->
              <destFile>${project.build.directory}/jacoco/fork-${surefire.forkNumber}.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>merge</id>
            <phase>test</phase>
            <goals>
              <goal>merge</goal>
            </goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${project.build.directory}/jacoco</directory>
                  <includes>
                    <include>fork-*.exec</include>
                  </includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/jacoco.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco.exec</dataFile>
            </configuration>
          </execution>
          <execution>
            <id>check</id>
            <phase>test</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <skip>${jacoco.check.skip}</skip>
              <dataFile>${project.build.directory}/jacoco.exec</dataFile>
              <rules>
                <rule>
                  <!-- One rule over the whole bundle rather than a per-class one, so that a small
                       fixture with an uncovered branch or two does not have to clear the same bar
                       as the tree as a whole. -->
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <!-- Instructions, not branches. Branch coverage of this tree sits under
                           this floor already, largely on fixture error paths a passing run
                           never takes. -->
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.minimum.coverage}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>
</project>
